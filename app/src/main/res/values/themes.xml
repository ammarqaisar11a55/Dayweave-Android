<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything. This only sets the window colour so launch doesn't flash white in dark mode. -->
    <style name="Theme.Dayweave" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
