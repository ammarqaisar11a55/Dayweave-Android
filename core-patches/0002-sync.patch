+fn signed_in(server: &Arc<Server>, name: &str) -> App {
+    let app = device(server);
+    app.call(
+        "sync.signUp",
+        json!({ "server": "https://sync.test", "email": "Ammar@Example.com", "password": "correct horse", "device": name }),
+    );
+    app
+}
+
+fn sync(app: &App) -> Value {
+    app.call("sync.run", json!({}))
+}
